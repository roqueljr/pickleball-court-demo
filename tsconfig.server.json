{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"],
    "noEmit": false
  },
  "include": ["server/**/*.ts", "prisma/seed.ts", "prisma/seed-if-empty.ts"]
}
