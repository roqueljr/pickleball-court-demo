{
  "name": "pickleball-business-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "deploy:build": "npm run db:generate && npm run build && npm run build:server",
    "start": "node dist-server/server/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit",
    "test": "node --experimental-strip-types tests/run-tests.ts",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:demo-api": "node --env-file=.env scripts/demo-api-smoke.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:constraint": "node scripts/apply-booking-constraint.mjs",
    "db:setup": "npm run db:push && npm run db:constraint && npm run db:seed",
    "db:deploy": "npm run db:push && npm run db:constraint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npm run build:server && node dist-server/prisma/seed.js",
    "db:seed-if-empty": "npm run build:server && node dist-server/prisma/seed-if-empty.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.14.0",
    "@tanstack/react-query": "^5.85.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
