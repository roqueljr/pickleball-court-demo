# PostgreSQL connection used by Prisma. Replace every placeholder.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Generate a unique value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Local development defaults. Production must use the exact public HTTPS origin.
NODE_ENV="development"
APP_URL="http://localhost:5173"
PORT=4000

# Requests allowed per IP in each 15-minute window.
API_RATE_LIMIT=1200
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTRATION_RATE_LIMIT=10
AUTH_EMAIL_RATE_LIMIT=5

# Email option A: SMTP. Fill these values or use the HTTP provider below.
# Example host: smtp.gmail.com
MAIL_HOST=""
MAIL_PORT=465
MAIL_USERNAME=""
MAIL_PASSWORD=""
# Use "ssl" for implicit TLS/port 465, or "tls" for STARTTLS/port 587.
MAIL_SMTPSecure="ssl"
MAIL_FROM="Rally Court Club <no-reply@yourdomain.example>"

# Email option B: Resend-compatible HTTP API. Fill all three values or use SMTP.
# Example endpoint: https://api.resend.com/emails
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="Rally Court Club <no-reply@yourdomain.example>"

# Reserved for future provider integrations. Current payments are manually verified.
PAYMENT_API_KEY=""
ACCESS_CONTROL_WEBHOOK_URL=""
DUPR_API_URL=""
DUPR_API_KEY=""
